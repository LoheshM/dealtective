SERPAPI_API_KEY=
# Same-product resolver + summary. Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or use OpenAI instead:
# OPENAI_API_KEY=
# LLM_PROVIDER=gemini          # gemini | openai (default: whichever key is set)
# LLM_MODEL=gemini-2.5-flash
# DEALTECTIVE_MODE=auto        # auto | live | replay
# DEALTECTIVE_CREDITS_PER_CHECK=5
